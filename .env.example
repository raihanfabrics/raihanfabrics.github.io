# Copy this file to .env and fill in your own Supabase project's values.
# Find these in your Supabase project: Settings → API.
#
# If left empty/unset, the app automatically runs on its local (offline)
# data layer instead — see src/lib/api.js — so it still works fine without
# any of this filled in, just without a shared real backend.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
